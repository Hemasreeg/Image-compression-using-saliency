# .gitignore for AI Portrait Mode

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
ENV/
env.bak/
venv.bak/

# PyTorch
*.pth
*.pt
*.ckpt
*.tar

# Flask
instance/
.webassets-cache

# Database
*.db
*.sqlite
*.sqlite3
portrait_app.db

# Environment Variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter Notebook
.ipynb_checkpoints

# Logs
*.log
logs/
tensorboard_logs/
runs/

# Uploaded Images
app/static/uploads/*
!app/static/uploads/.gitkeep
app/static/results/*
!app/static/results/.gitkeep

# Dataset (too large for git)
DUTS-TR/
DUTS-TE/
dataset/

# Model checkpoints
models/*.pth
models/*.pt
!models/.gitkeep

# OS
Thumbs.db
.DS_Store

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# pytest
.pytest_cache/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Docker
*.pid
*.seed
*.pid.lock
