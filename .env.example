# Environment Variables for AI Portrait Mode
# For Render deployment, set these in the Environment Variables section

# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key
GOOGLE_API_KEY=your-google-api-key-here
FLASK_APP=app.py
FLASK_ENV=production

# Database Configuration
# For local development, use SQLite (default)
# For Render, set DATABASE_URL to your PostgreSQL connection string
# Render automatically provides DATABASE_URL - no need to set if using PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/portrait_app

# Port (Render sets this automatically - no need to set)
PORT=5000

# File Upload Settings
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,bmp

# Model Settings
MODEL_PATH=models/best_model.pth
DEVICE=cuda  # or 'cpu' if no GPU

# Image Processing
DEFAULT_BLUR_STRENGTH=15
IMG_SIZE=320

# Server Settings
HOST=0.0.0.0
PORT=5000
DEBUG=False
